+++ b/tests/c/fixed_guest_identity.c
@@ -0,0 +1,40 @@
+#define _GNU_SOURCE
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/fsuid.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+    uid_t ruid, euid, suid;
+    gid_t rgid, egid, sgid;
+    assert(getuid() == 1234 && geteuid() == 1234);
+    assert(getgid() == 5678 && getegid() == 5678);
+    assert(getresuid(&ruid, &euid, &suid) == 0);
+    assert(ruid == 1234 && euid == 1234 && suid == 1234);
+    assert(getresgid(&rgid, &egid, &sgid) == 0);
+    assert(rgid == 5678 && egid == 5678 && sgid == 5678);
+    assert(setuid(1234) == 0 && setgid(5678) == 0);
+    assert(setresuid((uid_t)-1, 1234, (uid_t)-1) == 0);
+    assert(setresgid(5678, (gid_t)-1, 5678) == 0);
+    errno = 0;
+    assert(setuid(0) == -1 && errno == EPERM);
+    errno = 0;
+    assert(setgid(0) == -1 && errno == EPERM);
+    assert(setfsuid(0) == 1234 && setfsgid(0) == 5678);
+    assert(geteuid() == 1234 && getegid() == 5678);
+    char path[] = "/tmp/hermit-identity-XXXXXX";
+    int fd = mkstemp(path);
+    assert(fd >= 0);
+    struct stat metadata;
+    assert(fstat(fd, &metadata) == 0);
+    assert(metadata.st_uid == getuid() && metadata.st_gid == getgid());
+    assert(stat(path, &metadata) == 0);
+    assert(metadata.st_uid == getuid() && metadata.st_gid == getgid());
+    assert(close(fd) == 0 && unlink(path) == 0);
+    puts("fixed-guest-identity-ok");
+    return 0;
+}
diff --git a/tests/c/process_group_delivery.c b/tests/c/process_group_delivery.c
new file mode 100644
index 000000000..82c73d1f6
--- /dev/null
+++ b/tests/c/process_group_delivery.c
@@ -0,0 +1,233 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ * This source code is licensed under the BSD-style license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+#define _GNU_SOURCE
+#include <assert.h>
+#include <errno.h>
+#include <limits.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static void byte_write(int fd, char value) {
+  ssize_t n;
+  do { n = write(fd, &value, 1); } while (n < 0 && errno == EINTR);
+  assert(n == 1);
+}
+
+static char byte_read(int fd) {
+  char value;
+  ssize_t n;
+  do { n = read(fd, &value, 1); } while (n < 0 && errno == EINTR);
+  assert(n == 1);
+  return value;
+}
+
+static void wait_term(pid_t child) {
+  int status;
+  assert(waitpid(child, &status, 0) == child);
+  assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGTERM);
+}
+
+static void receive_user_signal(const sigset_t *mask, pid_t sender) {
+  siginfo_t info;
+  assert(sigwaitinfo(mask, &info) == SIGUSR1);
+  assert(info.si_signo == SIGUSR1 && info.si_code == SI_USER);
+  assert(info.si_pid == sender && info.si_uid == getuid());
+}
+
+static void other_group(const sigset_t *mask) {
+  int ready[2], result[2], control[3][2];
+  assert(pipe(ready) == 0 && pipe(result) == 0);
+  for (int i = 0; i < 3; ++i) assert(pipe(control[i]) == 0);
+  pid_t parent = getpid(), children[3];
+  for (int i = 0; i < 3; ++i) {
+    children[i] = fork();
+    assert(children[i] >= 0);
+    if (children[i] == 0) {
+      close(ready[0]);
+      close(result[0]);
+      for (int j = 0; j < 3; ++j) {
+        close(control[j][1]);
+        if (j != i) close(control[j][0]);
+      }
+      assert(byte_read(control[i][0]) == 'r');
+      byte_write(ready[1], (char)i);
+      if (i == 2) {
+        assert(byte_read(control[i][0]) == 'q');
+        sigset_t pending;
+        assert(sigpending(&pending) == 0);
+        assert(sigismember(&pending, SIGUSR1) == 0);
+        byte_write(result[1], (char)i);
+        _exit(0);
+      }
+      receive_user_signal(mask, parent);
+      byte_write(result[1], (char)i);
+      for (;;) pause();
+    }
+    assert(setpgid(children[i], i == 1 ? children[0] : children[i]) == 0);
+  }
+  close(ready[1]);
+  close(result[1]);
+  for (int i = 0; i < 3; ++i) {
+    close(control[i][0]);
+    byte_write(control[i][1], 'r');
+  }
+  unsigned seen = 0;
+  for (int i = 0; i < 3; ++i) seen |= 1U << byte_read(ready[0]);
+  assert(seen == 7);
+  assert(kill(-children[0], 0) == 0);
+  assert(kill(-children[0], SIGUSR1) == 0);
+  seen = 0;
+  for (int i = 0; i < 2; ++i) seen |= 1U << byte_read(result[0]);
+  assert(seen == 3);
+  assert(kill(-children[0], SIGTERM) == 0);
+  wait_term(children[0]);
+  wait_term(children[1]);
+  errno = 0;
+  assert(kill(-children[0], SIGUSR1) == -1 && errno == ESRCH);
+  byte_write(control[2][1], 'q');
+  assert(byte_read(result[0]) == 2);
+  int status;
+  assert(waitpid(children[2], &status, 0) == children[2]);
+  assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  for (int i = 0; i < 3; ++i) close(control[i][1]);
+  close(ready[0]);
+  close(result[0]);
+}
+
+/* Deliver to every other member before the sender can die. A per-member
+ * implementation that kills itself first strands its sibling here. */
+static void self_fatal_group(void) {
+  int ready[2], control[2][2];
+  assert(pipe(ready) == 0);
+  for (int i = 0; i < 2; ++i) assert(pipe(control[i]) == 0);
+  pid_t children[2];
+  for (int i = 0; i < 2; ++i) {
+    children[i] = fork();
+    assert(children[i] >= 0);
+    if (children[i] == 0) {
+      close(ready[0]);
+      for (int j = 0; j < 2; ++j) {
+        close(control[j][1]);
+        if (j != i) close(control[j][0]);
+      }
+      assert(byte_read(control[i][0]) == 'r');
+      byte_write(ready[1], (char)i);
+      if (i == 0) {
+        assert(byte_read(control[i][0]) == 't');
+        assert(kill(0, SIGTERM) == 0);
+      }
+      for (;;) pause();
+    }
+    assert(setpgid(children[i], children[0]) == 0);
+  }
+  close(ready[1]);
+  for (int i = 0; i < 2; ++i) {
+    close(control[i][0]);
+    byte_write(control[i][1], 'r');
+  }
+  unsigned seen = 0;
+  for (int i = 0; i < 2; ++i) seen |= 1U << byte_read(ready[0]);
+  assert(seen == 3);
+  byte_write(control[0][1], 't');
+  wait_term(children[0]);
+  wait_term(children[1]);
+  close(ready[0]);
+  for (int i = 0; i < 2; ++i) close(control[i][1]);
+}
+
+static void *blocked_sibling(void *ready) {
+  byte_write(*(int *)ready, 1);
+  for (;;) pause();
+  return NULL;
+}
+
+/* The first member is eligible; the second has ambiguous receiving threads.
+ * Compatibility mode exposes refusal as ENOSYS so both can check that no
+ * process-pending signal was queued before the refusal. */
+static void ambiguous_group(void) {
+  int ready[2], result[2], control[2][2];
+  assert(pipe(ready) == 0 && pipe(result) == 0);
+  for (int i = 0; i < 2; ++i) assert(pipe(control[i]) == 0);
+  pid_t children[2];
+  for (int i = 0; i < 2; ++i) {
+    children[i] = fork();
+    assert(children[i] >= 0);
+    if (children[i] == 0) {
+      close(ready[0]);
+      close(result[0]);
+      for (int j = 0; j < 2; ++j) {
+        close(control[j][1]);
+        if (j != i) close(control[j][0]);
+      }
+      assert(byte_read(control[i][0]) == 'r');
+      if (i == 1) {
+        pthread_t sibling;
+        assert(pthread_create(&sibling, NULL, blocked_sibling, &ready[1]) == 0);
+      } else {
+        byte_write(ready[1], 0);
+      }
+      assert(byte_read(control[i][0]) == 'q');
+      sigset_t pending;
+      assert(sigpending(&pending) == 0);
+      assert(sigismember(&pending, SIGUSR1) == 0);
+      byte_write(result[1], (char)i);
+      _exit(0);
+    }
+    assert(setpgid(children[i], children[0]) == 0);
+  }
+  close(ready[1]);
+  close(result[1]);
+  for (int i = 0; i < 2; ++i) {
+    close(control[i][0]);
+    byte_write(control[i][1], 'r');
+  }
+  unsigned seen = 0;
+  for (int i = 0; i < 2; ++i) seen |= 1U << byte_read(ready[0]);
+  assert(seen == 3);
+  errno = 0;
+  assert(kill(-children[0], SIGUSR1) == -1 && errno == ENOSYS);
+  for (int i = 0; i < 2; ++i) byte_write(control[i][1], 'q');
+  seen = 0;
+  for (int i = 0; i < 2; ++i) seen |= 1U << byte_read(result[0]);
+  assert(seen == 3);
+  for (int i = 0; i < 2; ++i) {
+    int status;
+    assert(waitpid(children[i], &status, 0) == children[i]);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    close(control[i][1]);
+  }
+  close(ready[0]);
+  close(result[0]);
+  puts("process-group-delivery ambiguous=refused partial-delivery=none");
+}
+
+int main(int argc, char **argv) {
+  sigset_t mask;
+  assert(sigemptyset(&mask) == 0 && sigaddset(&mask, SIGUSR1) == 0);
+  assert(sigprocmask(SIG_BLOCK, &mask, NULL) == 0);
+  if (argc == 2 && strcmp(argv[1], "ambiguous") == 0) {
+    ambiguous_group();
+    return 0;
+  }
+  assert(argc == 1);
+  other_group(&mask);
+  if (getpgrp() != getpid()) assert(setpgid(0, 0) == 0);
+  assert(kill(0, SIGUSR1) == 0);
+  receive_user_signal(&mask, getpid());
+  errno = 0;
+  assert(kill(0, INT_MAX) == -1 && errno == EINVAL);
+  errno = 0;
+  assert(kill(INT_MIN, SIGUSR1) == -1 && errno == ESRCH);
+  self_fatal_group();
+  puts("process-group-delivery fanout=ok sender=ok isolation=ok self=ok stale=ok self-termination=ok");
+  return 0;
+}
diff --git a/tests/c/sysv_shm.c b/tests/c/sysv_shm.c
new file mode 100644
index 000000000..397c29386
--- /dev/null
+++ b/tests/c/sysv_shm.c
@@ -0,0 +1,199 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
+ * This source code is licensed under the BSD-style license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/futex.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/mman.h>
+#include <sys/shm.h>
+#include <sys/wait.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+  fprintf(stderr, "sysv_shm:%d: %s errno=%d\n", __LINE__, #condition, errno); exit(1); \
+} } while (0)
+#define FAILS(expression, error) do { errno = 0; CHECK((expression) == -1); CHECK(errno == (error)); } while (0)
+
+static struct shmid_ds status(int id, unsigned long count) {
+  struct shmid_ds info;
+  memset(&info, 0xa5, sizeof(info));
+  CHECK(shmctl(id, IPC_STAT, &info) == 0);
+  CHECK(info.shm_nattch == count);
+  CHECK(info.shm_segsz == 56);
+  CHECK(info.shm_perm.cuid == getuid());
+  CHECK(info.shm_perm.cgid == getgid());
+  return info;
+}
+
+static void reap(pid_t pid) {
+  int result;
+  CHECK(waitpid(pid, &result, 0) == pid);
+  CHECK(WIFEXITED(result) && WEXITSTATUS(result) == 0);
+}
+
+/* Transport descriptors must never survive a successful or failed attachment,
+ * nor may their cleanup close an application-owned descriptor with a reused
+ * number. Check both the next allocation slot and a live canary descriptor. */
+static void descriptors_unchanged(int canary, int next_fd) {
+  int duplicate = dup(canary);
+  CHECK(duplicate == next_fd);
+  CHECK(close(duplicate) == 0);
+  CHECK(write(canary, "x", 1) == 1);
+}
+
+int main(int argc, char **argv) {
+  if (argc == 3 && strcmp(argv[1], "after-exec") == 0) {
+    status(atoi(argv[2]), 1); /* exec detached the child's inherited mapping */
+    volatile uint32_t *fresh = shmat(atoi(argv[2]), NULL, 0);
+    CHECK(fresh != (void *)-1 && fresh[0] == 789 && fresh[1] == 456);
+    status(atoi(argv[2]), 2);
+    CHECK(shmdt((const void *)fresh) == 0);
+    return 0;
+  }
+  CHECK(argc == 1);
+  int canary = open("/dev/null", O_RDWR | O_CLOEXEC);
+  CHECK(canary >= 0);
+  int next_fd = dup(canary);
+  CHECK(next_fd >= 0 && close(next_fd) == 0);
+  const key_t key = 0x513748;
+  FAILS(shmget(key, 56, 0600), ENOENT);
+  FAILS(shmget(IPC_PRIVATE, 0, 0600), EINVAL);
+  FAILS(shmget(IPC_PRIVATE, SIZE_MAX, 0600), EINVAL);
+  FAILS(shmget(IPC_PRIVATE, 56, SHM_HUGETLB | 0600), EOPNOTSUPP);
+  int id = shmget(key, 56, IPC_CREAT | IPC_EXCL | 0600);
+  CHECK(id >= 0);
+  FAILS(shmget(key, 56, IPC_CREAT | IPC_EXCL | 0600), EEXIST);
+  CHECK(shmget(key, 0, 0600) == id);
+  FAILS(shmget(key, 57, 0600), EINVAL);
+  struct shmid_ds info = status(id, 0);
+  CHECK(info.shm_cpid == getpid() && info.shm_atime == 0 && info.shm_dtime == 0);
+  CHECK(info.shm_ctime > 0);
+  volatile uint32_t *shared = shmat(id, NULL, 0);
+  CHECK(shared != (void *)-1);
+  CHECK(shared[0] == 0 && shared[1] == 0);
+  shared[0] = 123;
+  info = status(id, 1);
+  CHECK(info.shm_lpid == getpid() && info.shm_atime >= info.shm_ctime);
+  errno = 0;
+  CHECK(shmat(id, (void *)shared, 0) == (void *)-1 && errno == EINVAL);
+  status(id, 1); /* failed map must release its reservation without an attachment */
+  FAILS(shmctl(id, IPC_STAT, NULL), EFAULT);
+  FAILS(shmctl(id, IPC_SET, NULL), EFAULT);
+  FAILS(shmctl(id, SHM_LOCK, NULL), EOPNOTSUPP);
+  FAILS(shmdt((const void *)(shared + 1)), EINVAL);
+  FAILS(munmap((void *)shared, 4096), EOPNOTSUPP);
+  FAILS(madvise((void *)shared, 4096, MADV_DONTFORK), EOPNOTSUPP);
+  FAILS(syscall(SYS_mremap, shared, 0, 4096, MREMAP_MAYMOVE), EOPNOTSUPP);
+  errno = 0;
+  CHECK(shmat(id, (void *)shared, SHM_REMAP) == (void *)-1 && errno == EOPNOTSUPP);
+  errno = 0;
+  CHECK(mmap((void *)shared, 4096, PROT_READ | PROT_WRITE,
+             MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED);
+  CHECK(errno == EOPNOTSUPP && shared[0] == 123);
+  const volatile uint32_t *alias = shmat(id, NULL, SHM_RDONLY);
+  CHECK(alias != (void *)-1 && alias != shared && alias[0] == 123);
+  status(id, 2);
+  CHECK(shmdt((const void *)alias) == 0);
+  descriptors_unchanged(canary, next_fd);
+  info.shm_perm.mode = 0000;
+  CHECK(shmctl(id, IPC_SET, &info) == 0);
+  if (getuid() != 0) {
+    FAILS(shmget(key, 0, 0400), EACCES);
+    errno = 0;
+    CHECK(shmat(id, NULL, SHM_RDONLY) == (void *)-1 && errno == EACCES);
+    FAILS(shmctl(id, IPC_STAT, &info), EACCES);
+  }
+  info.shm_perm.mode = 0600;
+  CHECK(shmctl(id, IPC_SET, &info) == 0);
+  status(id, 1);
+
+  int ready[2], release[2];
+  CHECK(pipe(ready) == 0 && pipe(release) == 0);
+  pid_t child = fork();
+  CHECK(child >= 0);
+  if (child == 0) {
+    CHECK(shared[0] == 123);
+    shared[1] = 456;
+    CHECK(write(ready[1], "r", 1) == 1);
+    char token;
+    CHECK(read(release[0], &token, 1) == 1);
+    CHECK(shared[0] == 789);
+    _exit(0); /* exit, not shmdt, must release this mm's attachment */
+  }
+  char token;
+  CHECK(read(ready[0], &token, 1) == 1);
+  status(id, 2);
+  CHECK(shared[1] == 456);
+  shared[0] = 789;
+  CHECK(write(release[1], "g", 1) == 1);
+  reap(child);
+  status(id, 1);
+  CHECK(close(ready[0]) == 0 && close(ready[1]) == 0);
+  CHECK(close(release[0]) == 0 && close(release[1]) == 0);
+
+  /* Different virtual addresses in different mms must name the same shared
+   * futex. Wake retries only until the parent's real wait is registered. */
+  child = fork();
+  CHECK(child >= 0);
+  if (child == 0) {
+    volatile uint32_t *own_alias = shmat(id, NULL, 0);
+    CHECK(own_alias != (void *)-1 && own_alias != shared);
+    for (;;) {
+      long woken = syscall(SYS_futex, own_alias + 2, FUTEX_WAKE, 1, NULL, NULL, 0);
+      CHECK(woken >= 0);
+      if (woken == 1) break;
+      CHECK(sched_yield() == 0);
+    }
+    CHECK(shmdt((const void *)own_alias) == 0);
+    _exit(0);
+  }
+  CHECK(syscall(SYS_futex, shared + 2, FUTEX_WAIT, 0, NULL, NULL, 0) == 0);
+  reap(child);
+  status(id, 1);
+
+  child = fork();
+  CHECK(child >= 0);
+  if (child == 0) {
+    errno = 0;
+    execl("/hermit-sysv-shm-missing-executable", "missing", (char *)NULL);
+    CHECK(errno == ENOENT);
+    status(id, 2); /* a failed exec keeps the inherited mm attached */
+    char number[32];
+    snprintf(number, sizeof(number), "%d", id);
+    execl(argv[0], argv[0], "after-exec", number, (char *)NULL);
+    _exit(2);
+  }
+  reap(child);
+  status(id, 1);
+
+  CHECK(shmctl(id, IPC_RMID, NULL) == 0);
+  info = status(id, 1);
+  CHECK((info.shm_perm.mode & SHM_DEST) != 0);
+  FAILS(shmget(key, 0, 0), ENOENT);
+  int replacement = shmget(key, 56, IPC_CREAT | IPC_EXCL | 0600);
+  CHECK(replacement > id);
+  alias = shmat(id, NULL, SHM_RDONLY); /* Linux permits attaching a live removed ID */
+  CHECK(alias != (void *)-1 && alias[1] == 456);
+  status(id, 2);
+  CHECK(shmdt((const void *)alias) == 0);
+  CHECK(shmdt((const void *)shared) == 0);
+  FAILS(shmctl(id, IPC_STAT, &info), EINVAL);
+  CHECK(shmctl(replacement, IPC_RMID, NULL) == 0);
+  descriptors_unchanged(canary, next_fd);
+  CHECK(close(canary) == 0);
+  puts("sysv-shm shared=fork aliases=ok stat=ok rmid=ok exec=ok exit=ok errors=ok");
+  return 0;
+}
