+async def serve():
+    # Commands are serialized; the application behaves like a normal persistent
+    # service, while execute() keeps the original per-command DB context.
+    command_lock = asyncio.Lock()
+
+    async def handle(reader, writer):
+        try:
+            args = parse_command(json.loads(await reader.readline()))
+            async with command_lock:
+                result = await execute(args, app)
+            response = {'returncode': 0, 'result': result}
+        except Exception:
+            response = {'returncode': 1, 'error': traceback.format_exc()}
+        try:
+            writer.write(json.dumps(response).encode() + b'\n')
+            await writer.drain()
+        finally:
+            writer.close()
+            await writer.wait_closed()
+
+    # Bind before importing so the existing controller deadline also covers
+    # application initialization. Requests cannot execute until load_app returns.
+    server = await asyncio.start_unix_server(handle, path=SOCKET_PATH)
+    os.chmod(SOCKET_PATH, 0o600)
+    app = load_app()
+    async with server:
+        await server.serve_forever()
+
+
+def client(argv):
+    parse_command(argv)
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as stream:
+        stream.connect(SOCKET_PATH)
+        stream.sendall(json.dumps(argv).encode() + b'\n')
+        with stream.makefile('rb') as response_stream:
+            response = json.load(response_stream)
+    if response['returncode']:
+        print(response['error'], file=sys.stderr, end='')
+    else:
+        print(json.dumps(response['result']))
+    return response['returncode']
+
+
+if __name__ == '__main__':
+    if sys.argv[1:] == ['serve']:
+        asyncio.run(serve())
+    else:
+        raise SystemExit(client(sys.argv[1:]))
